# Copy to .env (cp .env.example .env). Everything here is optional; the app works without it.

# Host ports (change them if 5173 or 8000 are already in use on your machine)
# APP_PORT=5173
# API_PORT=8000

# Optional AI feedback on interview answers (Claude API). Leave empty to disable.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5   # default
# AI_FEEDBACK=0               # turn the AI feedback off even with a key

# Allowed browser origins for the API (comma-separated)
CORS_ORIGINS=http://localhost:5173
