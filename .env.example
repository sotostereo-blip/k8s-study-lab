# Copy to .env. Everything here is optional; the app works without it.

# Optional AI feedback on interview answers (Claude API). Leave empty to disable.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5   # default
# AI_FEEDBACK=0               # turn the AI feedback off even with a key

# Allowed browser origins for the API (comma-separated)
CORS_ORIGINS=http://localhost:5173
