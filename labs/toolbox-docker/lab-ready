#!/bin/bash
# Exit 0 when the engine answers, the preloaded images are loaded and the registry answers.
docker info >/dev/null 2>&1 || exit 1
for img in alpine:3.20 busybox:1.36 nginx:1.27-alpine python:3.12-alpine; do
  docker image inspect "$img" >/dev/null 2>&1 || exit 1
done
curl -sf http://registry:5000/v2/ >/dev/null
