#!/bin/bash
# Exit 0 when Istio (istiod and the ingress gateway) runs, the Gateway API CRDs exist and
# CoreDNS runs (with the legacy.lab entry).
[ -f /run/lab-bootstrap.done ] || exit 1
for d in istiod istio-ingressgateway; do
  kubectl -n istio-system rollout status deploy "$d" --timeout=5s >/dev/null 2>&1 || exit 1
done
kubectl -n kube-system rollout status deploy coredns --timeout=5s >/dev/null 2>&1 || exit 1
kubectl get crd gateways.gateway.networking.k8s.io >/dev/null 2>&1 || exit 1
