#!/bin/bash
# lab-logs REPO RUN_ID - the logs of every job of one run, each one after a "### job: NAME" line.
repo="${1:?usage: lab-logs REPO RUN_ID}"; run="${2:?usage: lab-logs REPO RUN_ID}"
jobs="$(gapi "repos/student/$repo/actions/runs/$run/jobs")" || exit 1
echo "$jobs" | jq -r '.jobs[] | "\(.id)\t\(.name)\t\(.conclusion)"' | while IFS=$'\t' read -r id name concl; do
  echo "### job: $name ($concl)"
  gapi "repos/student/$repo/actions/jobs/$id/logs" 2>/dev/null
  echo
done
