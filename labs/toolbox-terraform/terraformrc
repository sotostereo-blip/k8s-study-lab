# Use the providers baked into this image; anything else comes from the public registry.
provider_installation {
  filesystem_mirror {
    path    = "/opt/terraform/providers"
    include = ["registry.terraform.io/hashicorp/aws", "registry.terraform.io/hashicorp/random",
               "registry.terraform.io/hashicorp/local", "registry.terraform.io/hashicorp/null"]
  }
  direct {
    exclude = ["registry.terraform.io/hashicorp/aws", "registry.terraform.io/hashicorp/random",
               "registry.terraform.io/hashicorp/local", "registry.terraform.io/hashicorp/null"]
  }
}
